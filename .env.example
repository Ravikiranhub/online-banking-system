# BankSphere demo environment
# Copy to .env for docker-compose and local development.

MYSQL_DATABASE=banksphere
MYSQL_USER=banksphere
MYSQL_PASSWORD=banksphere123
MYSQL_ROOT_PASSWORD=rootpassword

DB_URL=jdbc:mysql://localhost:3306/banksphere?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=banksphere
DB_PASSWORD=banksphere123
JPA_DDL_AUTO=update

JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters-for-local-demo
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_DATA=true

VITE_API_BASE_URL=http://localhost:8080/api
